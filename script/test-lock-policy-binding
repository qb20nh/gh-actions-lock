#!/usr/bin/env python3
"""Generate a push-only PR-binding probe from the current trusted policy workflow."""

import argparse
from pathlib import Path
import re
import subprocess
import sys


def replace_once(text, old, new):
    if text.count(old) != 1:
        raise ValueError(f"Policy workflow shape changed: expected one {old!r}")
    return text.replace(old, new, 1)


def fixture(policy, number, head_sha):
    if not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", head_sha):
        raise ValueError("expected head must be a full commit SHA")
    if number <= 0:
        raise ValueError("pull request number must be positive")
    _, separator, body = policy.partition("\npermissions:\n")
    if not separator:
        raise ValueError("Policy workflow has no expected permissions block")
    generated = (
        "# Generated by script/test-lock-policy-binding from lock-policy.yml.\n"
        "# This exercises PR binding logic on push; it does not test the PRtarget trigger.\n"
        "name: M6 trusted PR policy binding smoke\n\n"
        "on:\n  push:\n    branches:\n      - codex/m6/pr-binding-*\n\n"
        "permissions:\n" + body
    )
    generated = replace_once(generated, "  policy:\n", "  policy:\n    if: github.repository == 'qb20nh/gh-actions-lock'\n")
    generated = replace_once(generated, "    name: Validate lock policy\n", "    name: Exercise trusted PR binding logic\n")
    generated = replace_once(generated,
        "      LOCK_EVENT_HEAD_SHA: ${{ github.event.pull_request.head.sha || github.sha }}\n",
        f"      LOCK_EVENT_HEAD_SHA: {head_sha}\n")
    generated = replace_once(generated,
        "      LOCK_EVENT_HEAD_REPOSITORY: ${{ github.event.pull_request.head.repo.full_name || github.repository }}\n",
        "      LOCK_EVENT_HEAD_REPOSITORY: qb20nh/gh-actions-lock\n")
    lines = []
    source_step = False
    runs = 0
    for line in generated.splitlines(keepends=True):
        if line.startswith("      - name:"):
            source_step = False
        if line == "        id: sources\n":
            source_step = True
        lines.append(line)
        if line == "        run: |\n":
            runs += 1
            lines.append("          export GITHUB_EVENT_NAME=pull_request_target\n")
            if source_step:
                lines.extend([
                    f"          printf '%s\\n' '{{\"number\":{number}}}' > \"$RUNNER_TEMP/lock-policy-smoke-event.json\"\n",
                    '          export GITHUB_EVENT_PATH="$RUNNER_TEMP/lock-policy-smoke-event.json"\n',
                ])
    if runs != 5:
        raise ValueError("Policy workflow step count changed; review probe generation")
    return "".join(lines)


def shell_blocks(text):
    lines = text.splitlines()
    for index, line in enumerate(lines):
        if line == "        run: |":
            block = []
            for following in lines[index + 1:]:
                if following and not following.startswith("          "):
                    break
                block.append(following[10:] if following else "")
            yield "\n".join(block) + "\n"


def main():
    root = Path(__file__).resolve().parent.parent
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--number", type=int, default=1)
    parser.add_argument("--expected-head-sha", default="ecca9970d5ecf0dd5c28679a5e18bab185542aea")
    parser.add_argument("--output", type=Path, default=root / "test/runtime/workflows/m6-pr-policy-smoke.yml")
    args = parser.parse_args()
    policy = (root / ".github/workflows/lock-policy.yml").read_text()
    generated = fixture(policy, args.number, args.expected_head_sha)
    for block in shell_blocks(generated):
        subprocess.run(["bash", "-n"], input=block, text=True, check=True)
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(generated)
    print(f"Generated {args.output}; five policy shell blocks pass bash -n")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f"error: {error}", file=sys.stderr)
        sys.exit(1)
